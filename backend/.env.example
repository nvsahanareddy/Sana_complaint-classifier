# ===================================================================
# Smart Complaint Assistant — Environment Configuration Template
# Copy this file to .env and adjust values for your environment.
# ===================================================================

# Admin & Authority Settings
# Comma-separated list of emails with authority to change report status:
ADMIN_EMAILS=admin@example.com,desk@city.gov

# Email used in the generated "open in email app" complaint draft:
AUTHORITY_EMAIL=grievance@city.gov

# Number of neighbour confirmations needed to close a report:
VERIFY_THRESHOLD=2

# Security & CORS Settings
# Set to 'false' in production to restrict allowed web origins:
ALLOW_ALL_ORIGINS=true

# Comma-separated list of permitted web origins when ALLOW_ALL_ORIGINS is false:
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,http://127.0.0.1:5500,http://localhost:5500

# Testing & Development Flags
# Allow the report creator to self-verify their own report (useful for single-user testing):
ALLOW_SELF_VERIFY=false
